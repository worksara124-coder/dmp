---
/**
 * Page contact : en-tête photo, demande guidée en 4 étapes avec bordereau en direct,
 * cartes de contact, carte, questions fréquentes.
 * Textes : src/data/contact.json · Styles : src/styles/accueil.css (base) + src/styles/contact.css
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactHero from '@/components/sections/contact-dmp/ContactHero.astro';
import RequestBuilder from '@/components/sections/contact-dmp/RequestBuilder.astro';
import ContactChannels from '@/components/sections/contact-dmp/ContactChannels.astro';
import ContactMap from '@/components/sections/contact-dmp/ContactMap.astro';
import ContactFaq from '@/components/sections/contact-dmp/ContactFaq.astro';
import Reveal from '@/components/sections/accueil/Reveal.astro';
import '@/styles/accueil.css';
import '@/styles/contact.css';
---

<BaseLayout
  wfPage="6ac536e68a1da6d6c4981e12"
  title="Contact | DMP Services, gestion des DASRI à Casablanca"
  description="Composez votre demande en 4 étapes ou contactez DMP Services pour la collecte et le traitement de vos déchets médicaux (DASRI) à Casablanca : 06 01 45 29 24, WhatsApp, contact@dmpservices.ma."
>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) { root.classList.add('dmp-ready'); return; }
      if ('IntersectionObserver' in window) root.classList.add('dmp-reveal-on');
      root.classList.add('dmp-anim');
      requestAnimationFrame(function () { requestAnimationFrame(function () { root.classList.add('dmp-ready'); }); });
    })();
  </script>
  <ContactHero />
  <RequestBuilder />
  <ContactChannels />
  <ContactMap />
  <ContactFaq />
  <Reveal />
</BaseLayout>