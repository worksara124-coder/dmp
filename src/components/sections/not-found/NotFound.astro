---
/** Page 404 simple : grand « 404 », titre, phrase, deux boutons, liens utiles. Styles : src/styles/not-found.css */
import Button from '@/components/dmp/Button.astro';
const links = [
  { label: 'Nos services', url: '/services/' },
  { label: 'Contact', url: '/contact/' },
  { label: 'FAQ', url: '/faq/' },
];
---

<section class="dmp-404">
  <div class="container-main dmp-404-inner">
    <p class="dmp-404-num dmp-404-in" aria-hidden="true">404</p>
    <h1 class="dmp-404-title dmp-404-in" style="--d:1">Page introuvable</h1>
    <p class="dmp-404-text dmp-404-in" style="--d:2">La page que vous cherchez n’existe pas ou a été déplacée.</p>
    <div class="dmp-404-actions dmp-404-in" style="--d:3">
      <Button href="/" label="Retour à l’accueil" variant="primary" arrow />
      <Button href="/contact/" label="Nous contacter" variant="secondary" />
    </div>
    <nav class="dmp-404-links dmp-404-in" style="--d:4" aria-label="Liens utiles">
      {links.map((l) => <a href={l.url}>{l.label}</a>)}
    </nav>
  </div>
</section>