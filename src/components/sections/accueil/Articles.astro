---
/** 11 — Derniers articles : défilement horizontal (glisser), barre de progression */
import data from '@/data/accueil.json';
import SectionHead from '@/components/dmp/SectionHead.astro';
import Button from '@/components/dmp/Button.astro';
import { getLatestPosts, formatDate } from '@/lib/content';
const a = data.articles;
const posts = await getLatestPosts(6);
const arrowUp = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>';
---

<section class="dmp-section dmp-articles is-white">
  <div class="container-main">
    <div class="dmp-head-row">
      <SectionHead eyebrow={a.eyebrow} title={a.title} />
      <div class="dmp-head-action" data-reveal><Button href={a.button.url} label={a.button.label} variant="secondary" arrow /></div>
    </div>
  </div>
  <ul class="dmp-hscroll" role="list" data-hscroll data-reveal>
    {posts.map((post) => (
      <li class="dmp-post">
        <a href={`/blog/${post.slug}`} draggable="false">
          <span class="dmp-post-media"><img src={post.mainImage.url} alt={post.mainImage.alt} loading="lazy" draggable="false" /></span>
          <span class="dmp-post-meta"><time datetime={post.publishedDate.toISOString()}>{formatDate(post.publishedDate)}</time>{post.category && <><span class="dmp-post-sep">/</span>{post.category}</>}</span>
          <span class="dmp-post-title">
            <span>{post.title}</span>
            <span class="dmp-post-arrow" set:html={arrowUp} />
          </span>
        </a>
      </li>
    ))}
  </ul>
  <div class="container-main">
    <div class="dmp-hscroll-bar" aria-hidden="true"><span data-hscroll-thumb></span></div>
  </div>
</section>