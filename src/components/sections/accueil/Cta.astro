---
/** 12 — CTA final : bloc vert foncé, titre, texte, deux boutons et contacts directs */
import data from '@/data/accueil.json';
import config from '@/config/config.json';
import { icon } from '@/lib/icons';
const c = data.cta;
const contact = data.contact;
---

<section class="dmp-section dmp-cta2 is-white">
  <div class="container-main">
    <div class="dmp-cta2-card" data-reveal>
      <div class="dmp-cta2-grid-bg" aria-hidden="true"></div>
      <div class="dmp-cta2-glow" aria-hidden="true"></div>
      <div class="dmp-cta2-content">
        <span class="dmp-eyebrow dmp-cta2-in" style="--k:0">(Devis gratuit)</span>
        <h2 class="dmp-h2 dmp-cta2-in" style="--k:1">{c.title}</h2>
        <p class="dmp-lead dmp-cta2-in" style="--k:2">{c.text}</p>
      </div>
      <div class="dmp-cta2-side">
        <div class="dmp-cta2-buttons dmp-cta2-in" style="--k:3">
          <a href={c.primary.url} class="dmp-btn dmp-cta2-primary"><span>{c.primary.label}</span><span class="dmp-btn-arrow" set:html={icon('arrow', 18, 1.8)} /></a>
          <a href={c.secondary.url} class="dmp-btn dmp-cta2-secondary"><span>{c.secondary.label}</span></a>
        </div>
        <ul class="dmp-cta2-contacts dmp-cta2-in" style="--k:4" role="list">
          <li><a href={contact.phoneHref}><span set:html={icon('phone', 18)} />{contact.phone}</a></li>
          <li><a href={`https://wa.me/${config.site.whatsapp}`} target="_blank" rel="noopener"><span set:html={icon('whatsapp', 18)} />WhatsApp</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>